  {
    "id": "f0f0f0f0f0f00001",
    "type": "function",
    "z": "a1b2c3d4e5f60001",
    "name": "Kiểm tra & tách telemetry",
    "func": "const out = [null, null, null, null, null, null, null, null];\nconst bad = (why) => {\n    node.status({ fill: 'red', shape: 'ring', text: why });\n    out[7] = { payload: 'Bỏ qua bản tin: ' + why };\n    return out;\n};\n\nlet d = msg.payload;\nif (typeof d === 'string') {\n    try { d = JSON.parse(d); } catch (e) { return bad('không phải JSON'); }\n}\nif (d === null || typeof d !== 'object' || Array.isArray(d)) return bad('JSON không phải object');\n\nconst num = (v) => (typeof v === 'number' && isFinite(v)) ? v : null;\nconst temp = num(d.temp);\nconst hum = num(d.hum);\n\nif (temp !== null) out[0] = { payload: temp };\nif (hum !== null) out[1] = { payload: hum };\n\nconst pts = [];\nif (temp !== null) pts.push({ topic: 'Nhiệt độ (°C)', payload: temp });\nif (hum !== null) pts.push({ topic: 'Độ ẩm (%)', payload: hum });\nif (pts.length) out[2] = pts;\n\nif (typeof d.led === 'boolean') {\n    out[3] = { payload: d.led ? 'BẬT' : 'TẮT', color: d.led ? '#f5a623' : '#9e9e9e' };\n}\nif (typeof d.button === 'boolean') {\n    out[4] = { payload: d.button ? 'Đang nhấn' : 'Thả', count: num(d.presses) ?? 0 };\n}\n\nconst rssi = num(d.rssi);\nif (rssi !== null) out[5] = { payload: rssi };\n\nconst up = num(d.uptime);\nif (up !== null) {\n    const h = Math.floor(up / 3600), m = Math.floor(up % 3600 / 60), s = Math.floor(up % 60);\n    out[6] = { payload: `${h} giờ ${String(m).padStart(2, '0')} phút ${String(s).padStart(2, '0')} giây` };\n}\n\nconst time = new Date().toLocaleTimeString('vi-VN');\nif (d.error || temp === null || hum === null) {\n    node.status({ fill: 'yellow', shape: 'dot', text: 'cảm biến lỗi ' + time });\n    out[7] = { payload: `Thiết bị báo lỗi cảm biến (${time})` };\n} else {\n    const src = d.sensor === 'sim' ? 'MÔ PHỎNG' : (d.sensor || '?');\n    node.status({ fill: 'green', shape: 'dot', text: `${temp}°C ${hum}% ${time}` });\n    out[7] = { payload: `Nguồn: ${src} · id ${d.id} · ${time}` };\n}\nreturn out;\n",
    "outputs": 8,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
